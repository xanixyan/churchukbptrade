# ============================================================================
# churchukbptrade - Development Dockerfile
# ============================================================================
# Hot reload via volume mount. Source is bind-mounted at /app.
#
# Usage: docker compose -f docker-compose.dev.yml up --build
# ============================================================================

FROM node:20-alpine

WORKDIR /app

# Build tools for bcrypt native module
RUN apk add --no-cache libc6-compat python3 make g++

COPY package.json package-lock.json* ./

# Install all dependencies (including devDependencies)
RUN npm install

# Copy source (overwritten by bind mount at runtime)
COPY . .

# Create data directories
RUN mkdir -p /app/data/sellers /app/data/orders /app/data/chats /app/data/users /app/data/buyers

EXPOSE 3000

ENV NODE_ENV=development
ENV HOSTNAME=0.0.0.0

CMD ["npm", "run", "dev"]
